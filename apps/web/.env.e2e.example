# Copiar a .env.e2e y ajustar la contraseña del tenant local.
# E2E_BASE_URL define baseURL de Playwright y el dominio de la cookie de sesión (global-setup).
E2E_BASE_URL=http://personal.localhost:3000
# Debe apuntar al mismo tenant/subdominio que E2E_BASE_URL (:8000 en dev local).
E2E_API_BASE_URL=http://personal.localhost:8000/api/v1
E2E_USER_EMAIL=admin@admin.com
E2E_USER_PASSWORD=your-dev-password
