{
  "name": "freelance-system",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "validate:touched": "bash scripts/validate-touched-files.sh",
    "dev:web": "pnpm --filter @freelance/web dev",
