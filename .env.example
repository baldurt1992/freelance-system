# =============================================================================
# Freelance System — monorepo (referencia)
# =============================================================================
# Este repo NO usa un único .env en la raíz para runtime.
# Cada app tiene su propio archivo:
#
#   api/.env.example   →  cp api/.env.example api/.env
#   apps/web/.env.example  →  cp apps/web/.env.example apps/web/.env
#
# Guía completa: docs/main/ONBOARDING.md
# =============================================================================

# --- Docker Compose (opcional, solo si usas docker-compose.dev.yml) ---
# MYSQL_ROOT_PASSWORD=root
# MYSQL_PASSWORD=freelance_dev_secret
# MYSQL_PUBLISH_PORT=3307
# REDIS_PUBLISH_PORT=6379
