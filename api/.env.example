APP_NAME="Freelance System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Central (landlord) database — MySQL 8
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freelance_central
DB_USERNAME=freelance
DB_PASSWORD=freelance_dev_secret

# Used by Stancl; subdomains like personal.localhost resolve against CENTRAL_DOMAIN
CENTRAL_DOMAIN=localhost

# file (SPA + Bearer). Usar database solo si publicas la migración sessions en central.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# redis + CacheTenancyBootstrapper (tags por tenant). No usar database en multi-tenant.
CACHE_STORE=redis
CACHE_PREFIX=freelance-central-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,personal.localhost,personal.localhost:3000

# Default owner for: php artisan tenant:provision personal
TENANT_PROVISION_EMAIL=you@example.com
TENANT_PROVISION_PASSWORD=
